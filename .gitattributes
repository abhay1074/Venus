# Fingerprinted artefacts (manifests, config) and everything WSL/Octave/MATLAB
# executes keep LF on every platform; Windows-native launchers keep CRLF.
* text=auto
*.csv   text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.m     text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.png   binary
*.jpg   binary
*.jpeg  binary
*.slx   binary
*.mat   binary
*.h5    binary
*.pdf   binary
