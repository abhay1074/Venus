# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Frontend
frontend/node_modules/
frontend/dist/

# Trained checkpoints: large binaries, copied in by hand (see README).
backend/weights/*.h5
!backend/weights/.gitkeep

# Runtime state: reports, the demo database, the cached sweep and timing runs
# are regenerated by the server / eval scripts.
backend/reports/
backend/data/venus.sqlite

# The old MediScan clone used as reference while building; not part of Venus AI.
mediscan-src/

# Local
.env
*.log

# Exported networks for MATLAB (regenerate with backend.eval.export_models)
models/export/
# Offline bundle output
dist/

# Dataset archives never belong in the repo
*.zip
*.zip.*
*.7z
backend/config/timing_report_cpu.json
# MATLAB / Simulink build products (the .slx itself is committed: buildDistrictModel regenerates it)
matlab/slprj/
matlab/**/slprj/
matlab/**/*.slxc
matlab/**/*.asv
matlab/models_cache/
matlab/simulink/sweep_result.json
